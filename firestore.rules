rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /sessions/{sessionId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['title', 'createdAt', 'createdBy'])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 100
        && request.resource.data.createdBy is string
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;

      match /messages/{messageId} {
        allow read: if true;
        allow create: if exists(/databases/$(database)/documents/sessions/$(sessionId))
          && request.resource.data.keys().hasOnly(['text', 'kind', 'speakerId', 'speakerName', 'createdAt'])
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000
          && request.resource.data.kind in ['kimochi', 'kaiketsu']
          && request.resource.data.speakerId is string
          && request.resource.data.speakerName is string
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
    }
  }
}
